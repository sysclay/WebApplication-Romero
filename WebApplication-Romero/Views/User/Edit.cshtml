
@model WebApplication_Romero.Models.User

@if (ViewBag.UsuarioNoEncontrado != null && ViewBag.UsuarioNoEncontrado == true)
{
    <div class="alert alert-danger">
        <strong>Usuario No Encontrado</strong>
        <p>Lo sentimos, no se ha encontrado el usuario solicitado.</p>
        <a href="/User/Lista" class="btn btn-secondary">Volver a la Lista</a>
    </div>
}
else
{
    <h2>Editar Usuario</h2>
    <form asp-action="Update" method="post">
        <input type="hidden" asp-for="UserId" />

        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" class="form-control" asp-for="nombre">
        </div>
        <div class="mb-3">
            <label for="correo" class="form-label">Correo</label>
            <input type="email" class="form-control" asp-for="correo">
        </div>
        <div class="mb-3">
            <label for="telefono" class="form-label">Teléfono</label>
            <input type="text" class="form-control" asp-for="telefono">
        </div>

        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        <a href="/User/Lista" class="btn btn-secondary">Cancelar</a>
    </form>
}
